# ============================================
# BMKG Data Platform — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# .env is gitignored. NEVER commit real credentials.
# ============================================


# General 
# comma-separated log levels for each modul
LOG_LEVEL=INFO
# Default timezone for timestamps (BMKG returns Asia/Jakarta)
TZ=Asia/Jakarta
# Random suffix to allow multiple local stacks (e.g. phase-1-dev, phase-2-test)
STACK_SUFFIX=

# BMKG API
# Public endpoint (no auth required as of wrting)
BMKG_BASE_URL=https://api.bmkg.go.id
BMKG_TIMEOUT_SEC=15
BMKG_USER_AGENT=bmkg-data-platform/0.1.0
# Rate limit: 60 req/min/ip - well respect this with retry

# MinIO (object storage /datalake)
# used starting phase 1 for raw bucket, expanded in phase 2+
MINIO_ROOT_USER=your_minio_user_here
MINIO_ROOT_PASSWORD=your_minio_password_here
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Buckets
MINIO_BUCKET_RAW=weather-raw
MINIO_BUCKET_STAGED=weather-staged
MINIO_BUCKET_MARTS=weather-marts

# PostgreSQL (data warehouse)
# activated in phase 1 profile for manual inspection
POSTGRES_USER=your_postgres_user_here
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=weather_dw
POSTGRES_PORT=5432

# Kafka (phase 6+)
KAFKA_BROKER_PORT=9092
KAFKA_TOPIC_WEATHER=weather-events 

# Spark (phase 3+)
SPARK_MASTER_PORT=7077
SPARK_UI_PORT=8080

# Airflow (phase 8+)
AIRFLOW_USER=your_airflow_user_here
AIRFLOW_PASSOWRD=your_airflow_password_here 
AIRFLOW_PORT=8080

# dbt (phase 5+)
DBT_PORIFLES_DIR=./warehouse/dbt

# Metabase (phase 12+)
METABASE_PORT=3000

# Grafana / Prometheus (phase 11+)
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
